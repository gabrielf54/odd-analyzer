{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: backend (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/ts",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/api/server.ts"],
      "console": "integratedTerminal"
    },
    {
      "name": "Vitest: arquivo atual",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/ts",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vitest", "run", "${relativeFile}"],
      "console": "integratedTerminal"
    }
  ]
}
