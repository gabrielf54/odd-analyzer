{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: front",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/streamlit_app.py"],
      "env": { "PYTHONPATH": "src" },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: arquivo atual",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: arquivo atual",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "env": { "PYTHONPATH": "src" },
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
